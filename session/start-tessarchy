#!/usr/bin/env bash
set -euo pipefail
if [[ -n ${WAYLAND_DISPLAY:-} || -n ${DISPLAY:-} ]]; then
    echo "Start Tessarchy from a local TTY, outside an existing graphical session." >&2
    exit 1
fi
for tool in start-hyprland qs dbus-run-session systemd-cat; do
    command -v "$tool" >/dev/null || { echo "Missing dependency: $tool" >&2; exit 1; }
done
share=${TESSARCHY_DATA_DIR:-${XDG_DATA_HOME:-$HOME/.local/share}/tessarchy}
if [[ ! -f "$share/session/hyprland.lua" ]]; then share=/usr/share/tessarchy; fi
[[ -f "$share/session/hyprland.lua" ]] || { echo "Session defaults not installed" >&2; exit 1; }
export TESSARCHY_DATA_DIR="$share"
export PATH="$HOME/.local/bin:$PATH"
# Stage the saved (or default) theme before anything reads it.
if command -v tessarchy-theme >/dev/null; then
    tessarchy-theme apply || echo "Theme unavailable; using built-in colours" >&2
fi
# Tessarchy first so xdg-desktop-portal reads tessarchy-portals.conf (file
# dialogs to tessarchy-portal), then Hyprland's for everything else.
export XDG_CURRENT_DESKTOP=Tessarchy:Hyprland
export XDG_SESSION_DESKTOP=tessarchy
export XDG_SESSION_TYPE=wayland
# Prefer the login user bus so portals, audio and authorization share the session.
if [[ -S ${XDG_RUNTIME_DIR:-/run/user/$UID}/bus ]]; then
    export DBUS_SESSION_BUS_ADDRESS="unix:path=${XDG_RUNTIME_DIR:-/run/user/$UID}/bus"
    exec systemd-cat --identifier=tessarchy-session start-hyprland -- --config "$share/session/hyprland.lua"
fi
exec systemd-cat --identifier=tessarchy-session dbus-run-session -- start-hyprland -- --config "$share/session/hyprland.lua"
