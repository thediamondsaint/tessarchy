#!/usr/bin/env bash
set -euo pipefail
share=${TESSARCHY_DATA_DIR:-${XDG_DATA_HOME:-$HOME/.local/share}/tessarchy}
if [[ ! -f "$share/shell/shell.qml" ]]; then share=/usr/share/tessarchy; fi
[[ -f "$share/shell/shell.qml" ]] || { echo "Tessera source not installed" >&2; exit 1; }
# The audio integration loads unconditionally and reconciles with PipeWire's
# live state inside the shell (AudioStatus.qml), so a late-starting media
# daemon no longer leaves audio controls permanently disabled.
# Offer the keyboard toggle only when the optional on-screen keyboard exists.
export TESSARCHY_OSK=0
if command -v squeekboard >/dev/null && command -v tessarchy-osk >/dev/null; then
    export TESSARCHY_OSK=1
fi
exec qs --no-duplicate --path "$share/shell/shell.qml" "$@"
