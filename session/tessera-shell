#!/usr/bin/env bash
set -euo pipefail
share=${TESSARCHY_DATA_DIR:-${XDG_DATA_HOME:-$HOME/.local/share}/tessarchy}
if [[ ! -f "$share/shell/shell.qml" ]]; then share=/usr/share/tessarchy; fi
[[ -f "$share/shell/shell.qml" ]] || { echo "Tessa source not installed" >&2; exit 1; }
export PATH="$HOME/.local/bin:$PATH"
# `tessera-shell ipc call <target> <function> ...` talks to the running shell.
if [[ ${1-} == ipc ]]; then
    shift
    exec qs ipc --path "$share/shell/shell.qml" "$@"
fi
# Load optional audio integration only when a PipeWire service socket exists.
export TESSARCHY_AUDIO=0
if [[ -S "${XDG_RUNTIME_DIR:-/run/user/$UID}/pipewire-0" ]]; then
    export TESSARCHY_AUDIO=1
fi
# Offer the keyboard toggle only when the optional on-screen keyboard exists.
export TESSARCHY_OSK=0
if command -v squeekboard >/dev/null && command -v tessarchy-osk >/dev/null; then
    export TESSARCHY_OSK=1
fi
exec qs --no-duplicate --path "$share/shell/shell.qml" "$@"
