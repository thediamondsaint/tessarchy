#!/usr/bin/env bash
# Rotate a Hyprland output through Tessarchy's generated Lua display rule.
set -euo pipefail

usage() { echo "usage: tessera-rotate <cycle|reset|0|1|2|3> <output>" >&2; exit 64; }

[[ $# -eq 2 ]] || usage
action=$1
output=$2
[[ $action == cycle || $action == reset || $action =~ ^[0-3]$ ]] || usage
[[ $output =~ ^[A-Za-z0-9._-]{1,64}$ ]] || { echo "Invalid output name: $output" >&2; exit 64; }
command -v hyprctl >/dev/null || { echo "hyprctl is required to rotate displays" >&2; exit 1; }

config_dir=${XDG_CONFIG_HOME:-$HOME/.config}/tessarchy
display_file=$config_dir/display.lua
mkdir -p -- "$config_dir"

monitors=$(hyprctl monitors) || { echo "Could not query Hyprland monitors" >&2; exit 1; }

# Refuse unknown outputs before writing anything; read only the frozen shapes.
block=$(printf '%s\n' "$monitors" | awk -v name="$output" '
    $1 == "Monitor" && $2 == name { found = 1; print; next }
    found && /^\t/ { print; next }
    found { exit }
    END { exit !found }
') || { echo "No such monitor: $output" >&2; exit 1; }

transform=$(printf '%s\n' "$block" | sed -n 's/^\ttransform: *\([0-9]\{1,\}\).*/\1/p' | head -n1)
geometry=$(printf '%s\n' "$block" | sed -n 's/^\t\([0-9]\{1,\}x[0-9]\{1,\}@[0-9.]\{1,\}\) at \(-[0-9]\{1,\}x-\?[0-9]\{1,\}\|[0-9]\{1,\}x-\?[0-9]\{1,\}\).*/\1 \2/p' | head -n1)
scale=$(printf '%s\n' "$block" | sed -n 's/^\tscale: *\([0-9.]\{1,\}\).*/\1/p' | head -n1)
if [[ ! $transform =~ ^[0-9]{1,2}$ || ! $geometry =~ ^[0-9]+x[0-9]+@[0-9.]+[[:space:]]-?[0-9]+x-?[0-9]+$ || ! $scale =~ ^[0-9.]+$ ]]; then
    echo "Could not read display settings for $output" >&2; exit 1
fi
mode=${geometry%% *}
position=${geometry##* }

backup=
if [[ -f $display_file ]]; then
    backup=$(mktemp)
    cp -- "$display_file" "$backup"
fi
reload_hyprland() {
    # The generated file also triggers Hyprland's own config watcher, and a
    # busy compositor can stall IPC for seconds; retry until it answers.
    for _ in $(seq 1 20); do
        hyprctl reload >/dev/null 2>&1 && return 0
        sleep 0.5
    done
    return 1
}
restore() {
    if [[ -n $backup ]]; then cp -- "$backup" "$display_file"; else rm -f -- "$display_file"; fi
    reload_hyprland || true
}
trap 'rm -f -- "${backup:-}"' EXIT

write_rule() {
    local value=$1 tmp
    tmp=$(mktemp "$config_dir/display.lua.XXXXXX")
    {
        echo "-- Generated by tessera-rotate. Do not edit by hand; run reset instead."
        echo "hl.monitor({ output = \"$output\", mode = \"$mode\", position = \"$position\", scale = $scale, transform = $value })"
        # Hyprland does not automatically rotate touch input with the output.
        echo "hl.config({ input = { touchdevice = { transform = $value } } })"
    } > "$tmp"
    chmod 0644 -- "$tmp"
    mv -f -- "$tmp" "$display_file"
}

current_transform() {
    hyprctl monitors | awk -v name="$output" '
        $1 == "Monitor" && $2 == name { found = 1; next }
        found && /transform:/ { sub(/^[^\t]*\ttransform: */, ""); sub(/[^0-9].*$/, ""); print; exit }
    '
}

apply_rule() {
    local value=$1 now
    write_rule "$value"
    if ! reload_hyprland; then
        echo "Hyprland rejected the display reload" >&2
        restore
        exit 1
    fi
    for _ in 1 2 3 4 5; do
        sleep 0.3
        now=$(current_transform)
        [[ ${now:-} == "$value" ]] && return 0
    done
    return 1
}

case $action in
cycle|[0-3])
    if [[ $action == cycle ]]; then next=$(( (transform + 1) % 4 )); else next=$action; fi
    if [[ $next == "$transform" && $action != cycle ]]; then
        echo "$output already at $(( next * 90 )) degrees"
        exit 0
    fi
    if ! apply_rule "$next"; then
        echo "Rotation did not apply; restoring the previous display state" >&2
        restore
        exit 1
    fi
    echo "Rotated $output to $(( next * 90 )) degrees"
    ;;
reset)
    if [[ ! -f $display_file ]]; then
        echo "No generated display rule to reset" >&2
        exit 0
    fi
    rm -f -- "$display_file"
    if ! reload_hyprland; then
        echo "Hyprland rejected the display reload" >&2
        restore
        exit 1
    fi
    echo "Display rotation reset to the configured default"
    ;;
esac
