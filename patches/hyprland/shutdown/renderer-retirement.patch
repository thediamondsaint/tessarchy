+bool CHyprGLRenderer::drainSubmittedWork(std::chrono::steady_clock::time_point deadline) {
+    if (!g_pHyprOpenGL || g_pHyprOpenGL->m_eglDisplay == EGL_NO_DISPLAY || g_pHyprOpenGL->m_eglContext == EGL_NO_CONTEXT)
+        return false;
+    if (eglMakeCurrent(g_pHyprOpenGL->m_eglDisplay, EGL_NO_SURFACE, EGL_NO_SURFACE, g_pHyprOpenGL->m_eglContext) != EGL_TRUE)
+        return false;
+    if (eglGetCurrentContext() != g_pHyprOpenGL->m_eglContext || eglGetCurrentDisplay() != g_pHyprOpenGL->m_eglDisplay || glGetGraphicsResetStatus() != GL_NO_ERROR)
+        return false;
+    return m_submittedWork.drain(deadline);
+}
