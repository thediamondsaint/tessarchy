 using namespace Screenshare;
 
+namespace {
+    CImageCaptureDelivery makeImageCaptureDelivery(WP<CExtImageCopyCaptureFrameV1> frame) {
+        return CImageCaptureDelivery([frame](EImageCaptureDelivery result) {
+            if (!frame || !frame->resource())
+                return;
+            switch (result) {
+                case EImageCaptureDelivery::READY: frame->sendReady(); break;
+                case EImageCaptureDelivery::FAILED_UNKNOWN: frame->sendFailed(EXT_IMAGE_COPY_CAPTURE_FRAME_V1_FAILURE_REASON_UNKNOWN); break;
+                case EImageCaptureDelivery::FAILED_STOPPED: frame->sendFailed(EXT_IMAGE_COPY_CAPTURE_FRAME_V1_FAILURE_REASON_STOPPED); break;
+                case EImageCaptureDelivery::FAILED_CONSTRAINTS: frame->sendFailed(EXT_IMAGE_COPY_CAPTURE_FRAME_V1_FAILURE_REASON_BUFFER_CONSTRAINTS); break;
+                case EImageCaptureDelivery::TIMESTAMP: {
+                    auto [sec, nsec] = Time::secNsec(Time::steadyNow());
+                    uint32_t tvSecHi = (sizeof(sec) > 4) ? sec >> 32 : 0;
+                    frame->sendPresentationTime(tvSecHi, sec & 0xFFFFFFFF, nsec);
+                    break;
+                }
+            }
+        });
+    }
+
+    FScreenshareCallback captureCallback(CImageCaptureDelivery delivery) {
+        return [delivery](eScreenshareResult result) {
+            switch (result) {
+                case RESULT_COPIED: delivery.finish(EImageCaptureDelivery::READY); break;
+                case RESULT_NOT_COPIED: delivery.finish(EImageCaptureDelivery::FAILED_UNKNOWN); break;
+                case RESULT_TIMESTAMP: delivery.notify(EImageCaptureDelivery::TIMESTAMP); break;
+            }
+        };
+    }
+
+    void captureError(eScreenshareError error, const CImageCaptureDelivery& delivery, SP<CExtImageCopyCaptureFrameV1> frame) {
+        switch (error) {
+            case ERROR_NONE: break;
+            case ERROR_NO_BUFFER:
+                delivery.cancel();
+                frame->error(EXT_IMAGE_COPY_CAPTURE_FRAME_V1_ERROR_NO_BUFFER, "no buffer attached");
+                break;
+            case ERROR_BUFFER_SIZE:
+            case ERROR_BUFFER_FORMAT: delivery.finish(EImageCaptureDelivery::FAILED_CONSTRAINTS); break;
+            case ERROR_STOPPED: delivery.finish(EImageCaptureDelivery::FAILED_STOPPED); break;
+            case ERROR_UNKNOWN: delivery.finish(EImageCaptureDelivery::FAILED_UNKNOWN); break;
+        }
+    }
+}
