+void CScreenshareManager::quiesceForShutdown() {
+    if (m_shutdown)
+        return;
+    m_shutdown = true;
+
+    // Mark every owner inert before destroying closures that can release or reenter peers.
+    for (auto& session : m_sessions) {
+        if (!session)
+            continue;
+        session->m_stopped = true;
+        session->m_sharing = false;
+    }
+    for (auto& session : m_cursorSessions) {
+        if (session)
+            session->m_stopped = true;
+    }
+    for (auto& frame : m_pendingFrames) {
+        if (frame)
+            frame->m_failed = true;
+    }
+    // Global cancellation is silent: emitting stopped can synchronously erase unique owners.
+    for (auto& managed : m_managedSessions)
+        managed->stoppedListener.reset();
+    for (auto& session : m_sessions) {
+        if (!session)
+            continue;
+        session->m_listeners = {};
+        if (session->m_shareStopTimer)
+            session->m_shareStopTimer->cancel();
+        session->m_shareStopTimer.reset();
+    }
+    for (auto& session : m_cursorSessions) {
+        if (!session)
+            continue;
+        session->m_listeners = {};
+    }
+    for (auto& frame : m_pendingFrames) {
+        if (frame)
+            frame->m_callback = {};
+    }
+    for (auto& session : m_cursorSessions) {
+        if (session)
+            session->m_pendingFrame = {};
+    }
+}
+
+void CScreenshareManager::releaseShutdownResources() {
+    if (!m_shutdown)
+        std::_Exit(EXIT_FAILURE);
+    // Called only after checked renderer drain, with its actual GL context still current.
+    for (auto& session : m_sessions) {
+        if (!session)
+            continue;
+        if (session->m_tempFB)
+            session->m_tempFB->release();
+        session->m_tempFB.reset();
+    }
+    m_pendingFrames.clear();
+    m_managedSessions.clear();
+    m_sessions.clear();
+    m_cursorSessions.clear();
+}
