+bool CHyprGLRenderer::checkedContext() {
+    if (!g_pHyprOpenGL || g_pHyprOpenGL->m_eglDisplay == EGL_NO_DISPLAY || g_pHyprOpenGL->m_eglContext == EGL_NO_CONTEXT)
+        return false;
+    if (eglMakeCurrent(g_pHyprOpenGL->m_eglDisplay, EGL_NO_SURFACE, EGL_NO_SURFACE, g_pHyprOpenGL->m_eglContext) != EGL_TRUE)
+        return false;
+    return eglGetCurrentContext() == g_pHyprOpenGL->m_eglContext && eglGetCurrentDisplay() == g_pHyprOpenGL->m_eglDisplay && glGetGraphicsResetStatus() == GL_NO_ERROR;
+}
+
+bool CHyprGLRenderer::retireResources(SSubmittedResources& resources) {
+    if (!checkedContext())
+        return false;
+    for (auto& framebuffer : resources.explicitReleases)
+        framebuffer->release();
+    resources.explicitReleases.clear();
+    return true;
+}
+
+void CHyprGLRenderer::deferFramebufferRelease(SP<IFramebuffer> framebuffer) {
+    if (m_shutdownDrain)
+        std::_Exit(EXIT_FAILURE);
+    m_pendingFBReleases.emplace_back(std::move(framebuffer));
+}
