pkgname=tessera-shell
pkgver=0.1.0
pkgrel=5
pkgdesc='Tessa touch-first Quickshell prototype'
arch=('any')
license=('MIT')
depends=('quickshell>=0.3.1' 'qt6-declarative' 'qt6-wayland' 'python' 'python-gobject' 'ffmpeg' 'util-linux')
optdepends=('upower: battery status' 'power-profiles-daemon: supported power modes' 'modemmanager: cellular calls, SMS and SIM controls' 'lpac: eSIM profile controls' 'lpa-gtk: eSIM enrollment')
source=("tessarchy-$pkgver.tar.gz" 'runtime-source.json')
# Local development source archive, generated by scripts/package.sh.
# Replace SKIP with a recorded checksum for release builds.
sha256sums=('SKIP' 'SKIP')
package() {
    install -Dm644 "$srcdir/LICENSE" "$pkgdir/usr/share/licenses/$pkgname/LICENSE"
    install -dm755 "$pkgdir/usr/share/tessarchy"
    cp -r "$srcdir/shell" "$pkgdir/usr/share/tessarchy/"
    install -Dm755 "$srcdir/session/tessera-shell" "$pkgdir/usr/bin/tessera-shell"
    install -Dm755 "$srcdir/session/tessera-chatgpt-status" "$pkgdir/usr/bin/tessera-chatgpt-status"
    install -Dm644 "$srcdir/runtime-source.json" "$pkgdir/usr/share/tessarchy/package-manifests/tessera-shell.json"
}
