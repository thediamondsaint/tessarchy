pkgname=tessarchy-tablet
pkgver=0.1.0
pkgrel=3
pkgdesc='Tessarchy Intel/AMD tablet desktop and hardware support profile'
arch=('x86_64')
license=('MIT')
depends=('tessarchy-session=0.1.0' 'tessarchy-bootsplash=0.1.0' 'linux-firmware' 'sof-firmware' 'alsa-ucm-conf'
         'mesa' 'vulkan-intel' 'vulkan-radeon' 'libinput' 'xorg-xwayland'
         'squeekboard' 'networkmanager' 'network-manager-applet' 'bluez' 'bluez-utils' 'blueman'
         'polkit' 'hyprpolkitagent' 'pipewire' 'pipewire-audio' 'pipewire-alsa' 'pipewire-pulse'
         'wireplumber' 'rtkit' 'upower' 'power-profiles-daemon' 'iio-sensor-proxy'
         'xdg-desktop-portal-hyprland' 'xdg-desktop-portal-gtk' 'xdg-user-dirs'
         'nautilus' 'gvfs' 'gvfs-mtp' 'udisks2' 'gnome-text-editor' 'papers' 'loupe' 'mpv'
         'file-roller' 'libreoffice-fresh' 'chromium' 'rnote' 'krita' 'celluloid' 'amberol'
         'gnome-calculator' 'noto-fonts' 'noto-fonts-emoji' 'wireless-regdb')
optdepends=('fwupd: supported device firmware updates')
