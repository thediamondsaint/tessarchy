    install -Dm644 "$srcdir/docs/tablet-install.md" "$pkgdir/usr/share/doc/$pkgname/tablet-install.md"
    install -Dm755 "$srcdir/session/tessarchy-readiness" "$pkgdir/usr/bin/tessarchy-readiness"
