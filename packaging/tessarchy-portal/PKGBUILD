pkgname=tessarchy-portal
pkgver=0.1.0
pkgrel=1
pkgdesc='Tessarchy file dialogs: portal backend drawn by Tessa on Phone/Tablet, GTK3 module'
arch=('x86_64' 'aarch64')
license=('MIT')
depends=('glib2' 'gtk3' 'xdg-desktop-portal' 'xdg-desktop-portal-gtk' 'tessera-shell=0.1.0')
makedepends=('gcc' 'make' 'pkgconf')
source=("tessarchy-$pkgver.tar.gz")
sha256sums=('SKIP')
build() {
    make -C "$srcdir/portal" O="$srcdir/build"
}
package() {
    make -C "$srcdir/portal" O="$srcdir/build" DESTDIR="$pkgdir" PREFIX=/usr install
    install -Dm644 "$srcdir/LICENSE" "$pkgdir/usr/share/licenses/$pkgname/LICENSE"
}
