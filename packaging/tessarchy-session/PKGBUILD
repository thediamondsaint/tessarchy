pkgname=tessarchy-session
pkgver=0.1.0
pkgrel=6
pkgdesc='Tessarchy prototype Hyprland session'
arch=('any')
license=('MIT' 'GPL-3.0-or-later')
depends=('tessera-shell=0.1.0' 'hyprland>=0.56' 'hypridle' 'dbus' 'chromium' 'foot' 'ttf-dejavu' 'grim' 'libnotify' 'openssh')
optdepends=('squeekboard: on-screen keyboard for touch text input'
            'brightnessctl: screen backlight control' 'hyprsunset: night light'
            'tessarchy-portal: touch file dialogs on Phone/Tablet')
source=("tessarchy-$pkgver.tar.gz" 'runtime-source.json')
sha256sums=('SKIP' 'SKIP')
package() {
    mkdir -p "$pkgdir/usr/share/tessarchy"
    cp -R "$srcdir/session" "$pkgdir/usr/share/tessarchy/"
    install -Dm644 "$srcdir/runtime-source.json" "$pkgdir/usr/share/tessarchy/package-manifests/tessarchy-session.json"
    install -Dm644 "$srcdir/LICENSE" "$pkgdir/usr/share/licenses/$pkgname/LICENSE"
    install -Dm755 "$srcdir/session/start-tessarchy" "$pkgdir/usr/bin/start-tessarchy"
    install -Dm755 "$srcdir/session/tessera-screenshot" "$pkgdir/usr/bin/tessera-screenshot"
    install -Dm755 "$srcdir/session/tessarchy-session-services" "$pkgdir/usr/bin/tessarchy-session-services"
    install -Dm755 "$srcdir/session/tessera-brightness" "$pkgdir/usr/bin/tessera-brightness"
    install -Dm755 "$srcdir/session/tessera-nightlight" "$pkgdir/usr/bin/tessera-nightlight"
    install -Dm755 "$srcdir/session/tessera-rotate" "$pkgdir/usr/bin/tessera-rotate"
    install -Dm755 "$srcdir/session/tessarchy-osk" "$pkgdir/usr/bin/tessarchy-osk"
    install -Dm755 "$srcdir/session/tessarchy-theme" "$pkgdir/usr/bin/tessarchy-theme"
    install -Dm755 "$srcdir/session/tessarchy-run" "$pkgdir/usr/bin/tessarchy-run"
    install -Dm755 "$srcdir/session/tessera-chatgpt-status" "$pkgdir/usr/bin/tessera-chatgpt-status"
    install -Dm755 "$srcdir/session/tessarchy-runtime" "$pkgdir/usr/bin/tessarchy-runtime"
    install -Dm644 "$srcdir/session/tessarchy-chatgpt.desktop" "$pkgdir/usr/share/applications/tessarchy-chatgpt.desktop"
    install -Dm755 "$srcdir/session/tessa-ai" "$pkgdir/usr/bin/tessa-ai"
    install -Dm755 "$srcdir/session/tessarchy-ssh" "$pkgdir/usr/bin/tessarchy-ssh"
    install -Dm644 "$srcdir/session/sshd_config.d/tessarchy.conf" "$pkgdir/etc/ssh/sshd_config.d/20-tessarchy.conf"
    cp -r "$srcdir/themes" "$pkgdir/usr/share/tessarchy/"
    install -Dm644 "$srcdir/session/tessarchy.desktop" "$pkgdir/usr/share/wayland-sessions/tessarchy.desktop"
}
